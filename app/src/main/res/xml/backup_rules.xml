<?xml version="1.0" encoding="utf-8"?>
<!--
  W-057 Phase 0: explicit Auto Backup decision for API 30 and lower.
  With no <include> elements Android keeps its default set (the Room database and every
  SharedPreferences file). Adding an <include> would restrict the set, so this file only excludes:
    - file/wine-images/        app-private image bytes; provenance is stored in Room instead
    - sharedpref/backup_credentials.xml   Keystore-wrapped GitHub/WebDAV secrets and the Drive grant
  Android Keystore keys never transfer to another phone, so a restored install reconnects anyway.
  Backup settings (backup_settings.xml), the reviewer list and the image-storage budget stay in
  Auto Backup. No credential ever enters BackupData or the JSON export.
-->
<full-backup-content>
    <exclude domain="file" path="wine-images/" />
    <exclude domain="sharedpref" path="backup_credentials.xml" />
</full-backup-content>
